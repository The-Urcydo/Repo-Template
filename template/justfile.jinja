# Optional shortcuts. Every recipe is a thin wrapper over a plain `python3 tools/...` command,
# so nothing here is required: agents without `just` run the commands shown in AGENTS.md.
# Install just: https://github.com/casey/just

default:
    @just --list

# Health check (run before every handoff)
check:
    python3 tools/check.py

# Health check, warnings fail too (CI)
check-strict:
    python3 tools/check.py --strict

# List unfilled placeholders
stubs:
    python3 tools/check.py --stubs

# Regenerate indexes and agent adapters
sync:
    python3 tools/sync_indexes.py
    python3 tools/sync_agents.py

# Is a newer template release available? (no network failure ever fails it)
template-status:
    python3 tools/template_status.py

# Turn on the optional pre-commit health check for this clone (worktrees share it)
hooks:
    git config core.hooksPath .githooks

# The tools in tools/ are template-owned: their tests live in the template repository, not here.
# Project-specific tools get their tests under the project's own tests/ folder.

# New work item: just item my-slug   (add --light for a one-file item, --worktree for a sibling worktree)
item *args:
    python3 tools/new_item.py {% raw %}{{args}}{% endraw %}

# Move an item: just move <id> in-review --next "..." --evidence "..."
move *args:
    python3 tools/transition.py {% raw %}{{args}}{% endraw %}

# Manage sibling worktrees: just wt create <id> / just wt remove <id> / just wt list
wt *args:
    python3 tools/worktree.py {% raw %}{{args}}{% endraw %}

# Archive done items and flag stale ones
sweep:
    python3 tools/archive_item.py --sweep

# New ADR: just adr "Use X for Y"
adr title:
    python3 tools/new_adr.py "{% raw %}{{title}}{% endraw %}"

# New doc: just doc how-to "Deploy to staging"
doc type title:
    python3 tools/new_doc.py {% raw %}{{type}}{% endraw %} "{% raw %}{{title}}{% endraw %}"

# Human decision queue
questions:
    python3 tools/question.py list

# List optional modules, or preview cutting one: just cut evals
cut name="":
    python3 tools/remove_module.py {% raw %}{{name}}{% endraw %}

{% if 'evals' in enabled_modules %}
# Verify or run harness evals
evals *args="--verify-fixtures":
    python3 tools/eval_harness.py {% raw %}{{args}}{% endraw %}
{% endif %}

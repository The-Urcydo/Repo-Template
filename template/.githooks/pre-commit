#!/bin/sh
# Optional pre-commit hook: the repo health check before every commit (about 0.3 s).
# Turn it on once per clone, worktrees included (they share the setting): `just hooks`
# or `git config core.hooksPath .githooks`. Nothing turns it on for you.
# Skip it once with `git commit --no-verify`. With the `github` module, CI is the real gate.
cd "$(git rev-parse --show-toplevel)" || exit 0
py=${PYTHON:-python3}
if ! command -v "$py" >/dev/null 2>&1 || [ ! -f tools/check.py ]; then
  echo "pre-commit: no $py or no tools/check.py here, skipping the health check (CI, if present, still runs it)" >&2
  exit 0
fi
status=0
"$py" tools/sync_indexes.py --check >/dev/null 2>&1 ||
  { echo "pre-commit: generated indexes are out of date. Fix: $py tools/sync_indexes.py" >&2; status=1; }
"$py" tools/sync_agents.py --check >/dev/null 2>&1 ||
  { echo "pre-commit: agent adapters are out of date. Fix: $py tools/sync_agents.py" >&2; status=1; }
"$py" tools/check.py >&2 || status=1
[ "$status" -eq 0 ] || echo "pre-commit: commit blocked. Fix the lines above and run git add, or skip once with --no-verify." >&2
exit "$status"
